[Unit]
Description=Structure private local first answer
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=exec
User=structural-answer
Group=structural
WorkingDirectory=/opt/structural-first-answer/release
ExecStart=/opt/structural-first-answer/runtime/bin/python -I -B /opt/structural-first-answer/release/scripts/serve-private-first-answer.py
RuntimeDirectory=structural-first-answer
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
UMask=0077

# Main's group may use worker.sock; the model socket is owner-only. These
# mounts hide production state, credential sockets and sibling runtime files.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
TemporaryFileSystem=/run:ro /var:ro /opt:ro /etc:ro
BindPaths=/run/structural-first-answer
BindReadOnlyPaths=/opt/structural-first-answer /etc/passwd /etc/group /etc/nsswitch.conf -/etc/ld.so.cache
InaccessiblePaths=-/srv -/mnt -/media -/usr/local/etc
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

# Both processes inherit these cgroup limits; all output stays off disk.
CPUQuota=400%
MemoryMax=6G
MemorySwapMax=0
TasksMax=64
LimitNOFILE=128
LimitCORE=0
OOMPolicy=stop
StandardInput=null
StandardOutput=null
StandardError=null
KillMode=control-group
TimeoutStopSec=15s
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
