# Large regeneratable data (exceed GitHub 100 MB limit)
# Authoritative copies live on HuggingFace / Zenodo, not in git.
# Regeneration: scripts/v2_pipeline_expanded.py (~1h runtime)
results/v2-discoveries-expanded.jsonl
results/v2-discoveries-expanded-raw.jsonl
v4/validation/soc-earthquake/catalog.jsonl
v4/validation/soc-wildfire/raw_nifc.csv
*.jsonl.bak
# KB rollback artifacts (pattern covers .bak-pre-* / .archive-pre-* suffixes)
*.jsonl.bak-pre-*
*.jsonl.archive-pre-*
# Audit trails from in-place KB rewrites (regen-able by rerunning the script)
data/wave3c-rewrite-results.json
.claude/

# D1 Phase Detector local DB artifacts
v4/product/d1_phase_detector/d1.sqlite
v4/product/d1_phase_detector/*.sqlite-journal

# D1 Phase Detector backtest price cache (regenerable via yfinance, ~25MB)
v4/product/d1_phase_detector/backtest/data/prices/
v4/product/d1_phase_detector/backtest/data/prices.meta.json

# Web backend history DB (per-device anonymous query history; ephemeral)
web/backend/data/history.db
web/backend/data/history.db-*
web/backend/data/sso_replay.sqlite3*
web/backend/data/auth.sqlite3*

# Auth / connections runtime stores — per-deployment state, never committed
web/backend/data/auth_users.jsonl
web/backend/data/auth_rate_limit.jsonl
web/backend/data/magic_tokens.jsonl
web/backend/data/mock_email_outbox.jsonl

# W12-A: a11y audit run-time artifacts (regenerable from pytest run)
web/tests/e2e/a11y-artifacts/
web/tests/e2e/.pytest_cache/
# axe-core script auto-downloaded by test_a11y_audit.py on first run (cached for offline use).
web/tests/e2e/.axe-core-*.min.js

# History scrub artifacts — patterns file holds RAW leaked keys, NEVER commit
scripts/scrub-patterns.txt
scripts/scrub-patterns.local.txt
.gitleaks-report.json
.gitleaks-report-after.json
.scrub-dry-run.log
.scrub-pre-backup/
data/kb-5000-merged.jsonl.archive-pre-v0.4-merge
