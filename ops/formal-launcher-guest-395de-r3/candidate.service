Type=simple
User=structural
Group=structural
WorkingDirectory=/srv/structural-isomorphism/releases/395de55b082e2cfb73111dbbe73d2571b3319c8d
ExecStart=/srv/structural-isomorphism/runtimes/cpython311-cpu-efd2731c4e9e-a3/bin/python -I -B /srv/structural-isomorphism/releases/395de55b082e2cfb73111dbbe73d2571b3319c8d/scripts/run-formal-main.py
EnvironmentFile=/etc/structural/structural-web.env
Environment=STRUCTURAL_ENV=prod
Environment=AUTH_ENABLED=true
Environment=AUTH_DEV_MODE=false
Environment=AUTH_SITE_ROLE=beta
Environment=AUTH_LINK_BASE_URL=https://beta.structural.bytedance.city
Environment=AUTH_DATA_DIR=/var/lib/structural-isomorphism
Environment=STRUCTURAL_SSO_DATA_DIR=/var/lib/structural-isomorphism
