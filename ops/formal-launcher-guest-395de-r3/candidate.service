Environment=STRUCTURAL_DATA_DIR=/srv/structural-isomorphism/artifacts/structural-v2-kb4443-20260711-433521ee0d30
Environment=STRUCTURAL_MODEL_PATH=/srv/structural-isomorphism/artifacts/structural-v2-kb4443-20260711-433521ee0d30/structural-v2
Environment=STRUCTURAL_PRECOMPUTED_EMBEDDINGS=/srv/structural-isomorphism/artifacts/structural-v2-kb4443-20260711-433521ee0d30/kb_v2_embeddings.npy
