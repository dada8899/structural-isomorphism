ReadWritePaths=/var/lib/structural-isomorphism /var/cache/structural-isomorphism
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
LimitCORE=0
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group

[Install]
