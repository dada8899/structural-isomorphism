[Unit]
Description=Structural Web Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Projects/structural-isomorphism/web/backend
Environment="PYTHONPATH=/root/Projects/structural-isomorphism"
EnvironmentFile=/root/Projects/structural-isomorphism/web/backend/.env
ExecStart=/root/Projects/structural-isomorphism/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 5004
# Keep the unit in "activating" until the model, canonical KB, embeddings and
# artifact manifest are genuinely ready. This closes the reboot window where
# systemd reported active while nginx still received connection refused.
ExecStartPost=/bin/bash -c 'for attempt in {1..18}; do /usr/bin/curl -fsS --max-time 2 "http://127.0.0.1:5004/api/health?deep=1" >/dev/null && exit 0; sleep 5; done; exit 1'
TimeoutStartSec=135
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/structural-web.log
StandardError=append:/var/log/structural-web.log

[Install]
WantedBy=multi-user.target
