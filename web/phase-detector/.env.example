# Phase Detector frontend environment

# Backend API base URL (W3-B FastAPI service)
NEXT_PUBLIC_API_BASE=http://localhost:8000
PHASE_API_INTERNAL_BASE=http://127.0.0.1:8200

# Set to "true" to bypass real API and use mock data from lib/mock-data.ts
NEXT_PUBLIC_USE_MOCK=true

# Enable only alongside the backend AUTH_ENABLED and SMTP configuration.
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_DEV_MODE=false
