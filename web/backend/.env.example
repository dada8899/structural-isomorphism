# M1.4 (session #16) — HMAC secret for share tokens. MUST be stable
# across deploys; rotating breaks every existing share URL. Generate
# once with `python -c "import secrets; print(secrets.token_hex(32))"`.
# Hard-required in prod (STRUCTURAL_ENV=prod) — the code raises if
# unset since the dev fallback is predictable from cwd.
STRUCTURAL_SHARE_TOKEN_SECRET=replace-me-with-64-hex-chars
