OPENROUTER_API_KEY=sk-or-v1-xxx
LLM_MODEL=openai/gpt-5.6-luna-pro
ASK_LLM_MODEL=openai/gpt-5.6-luna-pro
STRUCTURAL_DATA_DIR=/path/to/structural-isomorphism/data
STRUCTURAL_KB_FILE=kb-expanded.jsonl
STRUCTURAL_MODEL_PATH=/path/to/structural-isomorphism/models/structural-v2
STRUCTURAL_PRECOMPUTED_EMBEDDINGS=/path/to/structural-isomorphism/web/data/kb_v2_embeddings.npy.bak-session22
STRUCTURAL_ARTIFACT_MANIFEST=/path/to/structural-isomorphism/artifacts/production-v2-4443.json
PORT=5004
STRUCTURAL_ENV=dev
# Stable root for domain-separated email/IP/deletion-state HMACs. Production
# requires the unquoted lowercase 64-hex output of secrets.token_hex(32), with
# at least 12 distinct characters; rotate only with a migration.
STRUCTURAL_PRIVACY_HMAC_KEY=

# Passwordless account system. Production fails closed unless every required
# value is provided from the private environment file; never commit real values.
AUTH_ENABLED=false
JWT_SECRET=replace-with-private-32-plus-character-secret
AUTH_LINK_BASE_URL=https://phase.example.com
AUTH_DEV_MODE=false
# Must be outside the Git checkout in production so deploys cannot erase users.
AUTH_DATA_DIR=/var/lib/structural-isomorphism/auth
# Favorites defaults to AUTH_DATA_DIR/favorites.jsonl. Override only when a
# separately managed persistent volume is required; never point inside Git.
# STRUCTURAL_FAVORITES_PATH=/var/lib/structural-isomorphism/auth/favorites.jsonl
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=replace-with-private-username
SMTP_PASSWORD=replace-with-private-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_TIMEOUT_SECONDS=10
# Receives one email after a first-time account is successfully created.
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# M1.4 (session #16) — HMAC secret for share tokens. MUST be stable
# across deploys; rotating breaks every existing share URL. Generate
# once with `python -c "import secrets; print(secrets.token_hex(32))"`.
# Hard-required in prod (STRUCTURAL_ENV=prod) — the code raises if
# unset since the dev fallback is predictable from cwd.
STRUCTURAL_SHARE_TOKEN_SECRET=replace-me-with-64-hex-chars

# One shared high-entropy secret on Phase and beta signs two-minute SSO codes.
# It is never exposed to browser JavaScript and must remain stable/identical.
STRUCTURAL_SSO_SECRET=replace-with-private-64-hex-chars
STRUCTURAL_SSO_DATA_DIR=/var/lib/structural-isomorphism/sso
STRUCTURAL_SSO_PHASE_ORIGIN=https://phase.bytedance.city
STRUCTURAL_SSO_BETA_ORIGIN=https://beta.structural.bytedance.city
