# Example environment configuration for structural-isomorphism.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored
# (see .gitignore) — never commit your real keys.
#
# Usage:
#     cp .env.example .env
#     # edit .env, fill in real keys
#     set -a; source .env; set +a
#     python v4/scripts/b3_ensemble.py ...
#
# Or use a process manager like `direnv` / `dotenv-cli` to auto-load.

# ----------------------------------------------------------------------------
# LLM provider keys
# ----------------------------------------------------------------------------

# DeepSeek direct API (used by v4/scripts/b3_ensemble.py and
# v4/product/d1_phase_detector/extract_structtuple.py).
# Get a key at https://platform.deepseek.com.
DEEPSEEK_API_KEY=sk-your-key-here

# OpenRouter (optional fallback router for cross-vendor ensemble; CN region
# may be blocked — see paper appendix).
# OPENROUTER_API_KEY=sk-or-your-key-here

# ----------------------------------------------------------------------------
# Optional configuration
# ----------------------------------------------------------------------------

# Override DeepSeek default model (v4/scripts/b3_ensemble.py respects this).
# DEEPSEEK_MODEL=deepseek-v4-pro

# Override DeepSeek base URL (for self-hosted proxies / region failover).
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# ----------------------------------------------------------------------------
# Web backend (web/backend) — launch hardening knobs
# ----------------------------------------------------------------------------

# Deployment environment. "prod" disables /docs /redoc /openapi.json and
# requires STRUCTURAL_SHARE_TOKEN_SECRET to be set. Default: dev.
# STRUCTURAL_ENV=prod

# Daily LLM-call circuit breaker (launch P0-2). Total LLM-backed requests
# (/api/ask + /api/analyze) allowed per UTC day before the service returns
# a friendly 429. <= 0 disables the cap (NOT recommended in prod).
# Default: 500.
# STRUCTURAL_LLM_DAILY_CALL_CAP=500

# /api/analyze out-of-scope similarity floor (launch P1-3). A query-mode
# analyze request whose query-vs-KB cosine is below this is declined
# instead of generating a report. Default: 0.30 (deliberately lax — the
# deterministic trivial/chit-chat detector is the primary gate).
# ANALYZE_SCOPE_MIN_SIMILARITY=0.30
